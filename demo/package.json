{
    "name": "todomvc-react",
    "version": "1.0.0",
    "description": "A TodoMVC written in React.",
    "private": true,
    "engines": {
        "node": ">=20.19.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "build": "webpack --config webpack.prod.js",
        "dev": "webpack serve --open --config webpack.dev.js",
        "serve": "http-server ./dist/webpack -p 7002 -c-1 --cors",
        "build:webpack": "webpack --config webpack.prod.js",
        "serve:webpack": "http-server ./dist/webpack -p 7002 -c-1 --cors",
        "build:vite": "vite build",
        "dev:vite": "vite",
        "serve:vite": "vite preview --outDir dist/vite",
        "build:rollup": "rimraf dist/rollup && rollup -c rollup.config.mjs",
        "serve:rollup": "http-server ./dist/rollup -p 7003 -c-1 --cors",
        "build:esbuild": "rimraf dist/esbuild && node build.esbuild.mjs",
        "serve:esbuild": "http-server ./dist/esbuild -p 7004 -c-1 --cors",
        "build:all": "npm run build:webpack && npm run build:vite && npm run build:rollup && npm run build:esbuild",
        "benchmark": "node benchmark.mjs",
        "phase:transpile": "node phases/1-transpile.mjs",
        "phase:transpile:benchmark": "node phases/transpile-benchmark.mjs",
        "phase:resolve": "node phases/2-resolve.mjs",
        "phase:bundle": "node phases/3-bundle.mjs",
        "phase:optimize": "node phases/4-optimize.mjs",
        "phase:tree-shaking": "node phases/5-tree-shaking-lodash.mjs"
    },
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.0",
        "@babel/preset-env": "^7.29.3",
        "@babel/preset-react": "^7.28.5",
        "@rollup/plugin-commonjs": "^28.0.1",
        "@rollup/plugin-html": "^2.0.0",
        "@rollup/plugin-node-resolve": "^16.0.0",
        "@rollup/plugin-replace": "^6.0.1",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.10.1",
        "@vitejs/plugin-react": "^4.3.4",
        "babel-loader": "^10.1.1",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.4",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "esbuild": "^0.24.0",
        "esbuild-visualizer": "^0.7.0",
        "html-webpack-plugin": "^5.6.7",
        "http-server": "^14.1.1",
        "lodash": "^4.18.1",
        "lodash-es": "^4.18.1",
        "mini-css-extract-plugin": "^2.10.2",
        "rimraf": "^6.0.1",
        "rollup": "^4.28.1",
        "rollup-plugin-esbuild": "^6.1.1",
        "rollup-plugin-postcss": "^4.0.2",
        "style-loader": "^4.0.0",
        "vite": "^6.0.3",
        "webpack": "^5.106.2",
        "webpack-cli": "^7.0.2",
        "webpack-dev-server": "^5.2.3",
        "webpack-merge": "^6.0.1"
    },
    "dependencies": {
        "classnames": "^2.5.1",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-router-dom": "^7.14.2",
        "todomvc-app-css": "^2.4.3",
        "todomvc-common": "^1.0.5"
    }
}
